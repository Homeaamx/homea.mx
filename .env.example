# Plantilla de variables de entorno. Copiar a .env.local y rellenar.
# NUNCA commitear valores reales: .env* está en .gitignore (salvo este archivo).

# ---------------------------------------------------------------------------
# Shopify Storefront API (canal Headless)
# ---------------------------------------------------------------------------
# Dominio de la tienda. Funciona el dominio público o el .myshopify.com.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=homeashop.mx
# Token PRIVADO del canal Headless. Sin él, el carrito cae a modo simulado en
# desarrollo y avisa en producción. Ojo: el acceso "tokenless" de Shopify NO
# sirve aquí mientras la tienda tenga contraseña ("Online Store channel is locked").
SHOPIFY_STOREFRONT_API_TOKEN=
# Versión de la API. Shopify sostiene cada versión 12 meses.
SHOPIFY_STOREFRONT_API_VERSION=2026-07
# Secreto del webhook de revalidación on-demand (ISR).
SHOPIFY_REVALIDATION_SECRET=

# ---------------------------------------------------------------------------
# Tipo de cambio USD → MXN (lib/tipoCambio.ts)
# ---------------------------------------------------------------------------
# Token del SIE de Banxico (gratuito): https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Sin token, el sitio usa el valor de respaldo (17.43) y lo dice en la nota.
BANXICO_TOKEN=
# Diferencial sobre el FIX, en tanto por uno (0.02 = 2%). El FIX es referencia,
# no precio de venta; aquí se configura el margen que decida HOMEA. Vacío = 0.
TIPO_CAMBIO_SPREAD=
# Tipo de cambio fijo que GANA sobre Banxico. Se usa cuando la cotización debe ir
# con el tipo de cambio del banco ("TC Santander a la venta"), que no tiene API.
TIPO_CAMBIO_MANUAL=
# Secreto que Vercel Cron manda como `Authorization: Bearer ...`.
# Lo genera Vercel al configurar el cron; sin él el endpoint responde 401.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Leads
# ---------------------------------------------------------------------------
KOMMO_WEBHOOK_URL=
KOMMO_API_TOKEN=

# ---------------------------------------------------------------------------
# Analítica
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=

# ---------------------------------------------------------------------------
# Sitio
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.homea.mx
